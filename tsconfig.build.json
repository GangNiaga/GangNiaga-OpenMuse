{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["api/**/*.ts", "apps/server/**/*.ts", "apps/worker/**/*.ts", "packages/**/*.ts"],
  "exclude": ["node_modules", "tests", "apps/mobile", "apps/worker/tests"]
}
